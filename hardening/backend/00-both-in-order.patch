@@ -0,0 +1,97 @@
+name: Dependency Security (lockfiles)
+
+# `scripts/ci/security_gate.py` shipped a documented-but-unwired contract: its
+# own docstring described a Trivy step no workflow ever ran, so HIGH/CRITICAL
+# CVEs in the pinned lockfiles had no gate at all. Same story as CodeQL before
+# `codeql.yml`: config present, nothing executing it.
+#
+# The gateway *image* scan lives in `gateway-image.yml` (it scans the image it
+# already built for GHCR — no second build).
+#
+# Additive by design (mirrors codeql.yml): findings are printed and uploaded as
+# artefacts. The job is REPORT-ONLY (`exit-code: 0`) because the first run
+# against the current lockfiles is a baseline, not a regression — promoting it
+# to blocking is a one-line change once the baseline is clean.
+#
+# Security note: trivy-action is pinned to a full commit SHA (not a tag, never
+# @master) — mutable action refs have been a compromise vector before.
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "gateway/Dockerfile"
+      - "gateway/requirements.lock"
+      - "core/requirements.lock"
+      - ".github/workflows/container-security.yml"
+  pull_request:
+    branches: [main]
+    paths:
+      - "gateway/Dockerfile"
+      - "gateway/requirements.lock"
+      - "core/requirements.lock"
+      - ".github/workflows/container-security.yml"
+  schedule:
+    # Weekly re-scan catches CVEs published against images already shipped.
+    - cron: '30 6 * * 1'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: container-security-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  dependency-cve-gate:
+    name: "Dependency CVE gate (lockfiles)"
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5
+        with:
+          persist-credentials: false
+
+      - name: Trivy fs scan (lockfiles, JSON)
+        uses: aquasecurity/trivy-action@a9c7b0f06e461e9d4b4d1711f154ee024b8d7ab8 # v0.36.0
+        with:
+          scan-type: fs
+          scan-ref: .
+          scanners: vuln
+          severity: HIGH,CRITICAL
+          ignore-unfixed: true
+          format: json
+          output: trivy-report.json
+          exit-code: "0"   # report-only stage 1 — see header
+
+      - name: Evaluate with the repo security gate
+        run: |
+          set +e
+          python scripts/ci/security_gate.py --trivy trivy-report.json --output security-report.json
+          rc=$?
+          set -e
+          python - <<'PY'
+          import json, pathlib
+          report = json.loads(pathlib.Path("security-report.json").read_text(encoding="utf-8"))
+          findings = report.get("blocking_findings", [])
+          print(f"blocking_findings={len(findings)} status={report.get('status')}")
+          for f in findings[:50]:
+              print(f"  {f['severity']:8} {f['id']:18} {f['package']:24} {f['target']}")
+          if len(findings) > 50:
+              print(f"  ... {len(findings) - 50} more")
+          PY
+          if [ "$rc" -ne 0 ]; then
+            echo "::warning::Dependency CVE gate would block: HIGH/CRITICAL fixable dependencies present (report-only stage 1)."
+          fi
+
+      - name: Upload dependency report
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: trivy-dependency-report
+          path: |
+            trivy-report.json
+            security-report.json
+          if-no-files-found: warn
+          retention-days: 14
