+#!/usr/bin/env python3
+"""Keep top-level module count NON-INCREASING (sprawl ratchet).
+
+Context: ``core/`` carries 150 top-level modules, eleven of them ``config*``
+(``config``, ``config_cache``, ``config_classification``, ``config_control_plane``,
+``config_fields``, ``config_parsers``, ``config_proxy``, ``config_registry``,
+``config_validation``, ``config_validator``). Each one is individually
+justified — ``config_fields``/``config_validation`` really are the internal
+decomposition of ``Settings`` — but the *aggregate* is the problem: a newcomer
+cannot tell which of the eleven owns a given concern, and every new concern
+historically spawned a twelfth file.
+
+A big-bang merge would break 230+ import sites for cosmetic gain. This guard
+takes the cheap, reversible half: the count may never grow again. New
+responsibility must land in an existing module (or replace one), and every
+deletion lowers the budget below.
+
+Usage:
+    python scripts/ci/check_module_budget.py
+    python scripts/ci/check_module_budget.py --show     # current vs budget
+    python scripts/ci/check_module_budget.py --lower    # print the tightened value
+"""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+
+# (glob, budget, rationale)
+BUDGETS: tuple[tuple[str, int, str], ...] = (
+    ("core/*.py", 150, "top-level core modules (11 config*, 4 health*, 3 intent*)"),
+    ("core/api/routes/*.py", 162, "flat route modules mounted by core/api/routers.py"),
+)
+
+
+def count(pattern: str) -> int:
+    # Only files directly matching the glob — `core/*.py` must not recurse, or
+    # every subpackage module would inflate the figure and the guard would be
+    # meaningless.
+    return len(sorted(ROOT.glob(pattern)))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--show", action="store_true")
+    parser.add_argument("--lower", action="store_true")
+    args = parser.parse_args()
+
+    violations: list[str] = []
+    rows: list[str] = []
+    for pattern, budget, why in BUDGETS:
+        actual = count(pattern)
+        rows.append(f"{pattern:28} {actual:4} / {budget:4}  {'OK' if actual <= budget else 'OVER'}  — {why}")
+        if actual > budget:
+            violations.append(
+                f"{pattern}: {actual} modules > budget {budget}. "
+                "Add the new responsibility to an existing module, or delete an obsolete one and "
+                f"lower the budget in {__file__.replace(str(ROOT) + '/', '')}."
+            )
+
+    if args.lower:
+        for pattern, _budget, _why in BUDGETS:
+            print(f'    ("{pattern}", {count(pattern)}),')
+        return 0
+    if args.show:
+        print("\n".join(rows))
+        return 0
+
+    print("\n".join(rows))
+    for v in violations:
+        print(f"::error::{v}")
+    if violations:
+        return 2
+    print("module budget OK (non-increasing)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/ci/check_mypy_ratchet.py b/scripts/ci/check_mypy_ratchet.py
new file mode 100755
index 0000000..bfe4db2
--- /dev/null
+++ b/scripts/ci/check_mypy_ratchet.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Fail CI when a ratchet-listed module stops being type-clean.
+
+The mypy *config* in ``core/pyproject.toml`` has said ``strict = true`` for a
+long time while no workflow ran mypy — a decorative guard. This script makes
+the ratchet real without a big-bang migration:
+
+* only files in ``config/ci/mypy-ratchet.txt`` are checked;
+* the list only grows;
+* a bare ``# type: ignore`` (no error code) inside a ratcheted file is a
+  policy violation, because it silences future, unrelated errors wholesale.
+
+Usage:
+    python scripts/ci/check_mypy_ratchet.py            # enforce
+    python scripts/ci/check_mypy_ratchet.py --list     # print the ratchet
+"""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import re
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+RATCHET = ROOT / "config" / "ci" / "mypy-ratchet.txt"
+BARE_IGNORE = re.compile(r"#\s*type:\s*ignore\s*(?:$|[,)\]])")
+
+
+def ratchet_files() -> list[str]:
+    if not RATCHET.exists():
+        raise SystemExit(f"::error::missing ratchet manifest: {RATCHET}")
+    out: list[str] = []
+    for raw in RATCHET.read_text(encoding="utf-8").splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        out.append(line)
+    return out
+
+
+def bare_ignores(path: str) -> list[str]:
+    hits: list[str] = []
+    file = ROOT / path
+    if not file.exists():
+        return hits
+    for i, line in enumerate(file.read_text(encoding="utf-8").splitlines(), 1):
+        if BARE_IGNORE.search(line):
+            hits.append(f"{path}:{i}: bare `# type: ignore` (add an error code)")
+    return hits
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--list", action="store_true", help="print ratchet entries and exit")
+    parser.add_argument("--python", default=sys.executable, help="python interpreter owning mypy")
+    args = parser.parse_args()
+
+    files = ratchet_files()
+    if args.list:
+        print("\n".join(files))
+        return 0
+    if not files:
+        print("::error::mypy ratchet is empty — the guard would silently pass forever")
+        return 2
+
+    missing = [f for f in files if not (ROOT / f).exists()]
+    if missing:
+        for path in missing:
+            print(f"::error file={path}::ratchet entry no longer exists — delete the line or restore the module")
+        return 2
+
+    ignores = [hit for path in files for hit in bare_ignores(path)]
+    for hit in ignores:
+        print(f"::error::{hit}")
+
+    cmd = [
+        args.python, "-m", "mypy",
+        "--ignore-missing-imports",
+        "--follow-imports=skip",
+        "--no-error-summary",
+        *files,
+    ]
+    print(f"+ {' '.join(cmd)}")
+    proc = subprocess.run(cmd, cwd=ROOT, check=False)
+    if proc.returncode != 0:
+        print("::error::mypy ratchet regressed — a ratcheted module no longer type-checks")
+        return proc.returncode
+    if ignores:
+        return 2
+    print(f"mypy ratchet OK ({len(files)} modules type-clean)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/infrastructure/mcp-control-plane/docs/TOOL-EXPOSURE.md b/infrastructure/mcp-control-plane/docs/TOOL-EXPOSURE.md
index fc47f79..05624bc 100644
--- a/infrastructure/mcp-control-plane/docs/TOOL-EXPOSURE.md
+++ b/infrastructure/mcp-control-plane/docs/TOOL-EXPOSURE.md
@@ -176,3 +176,64 @@ normalization + anonymous e2e (`bridge.guide` executes with no context token).
 - `test_bridge_onboarding.ts` — bridge surface contract tests
 - `../../scripts/bridge/README.md` — bridge operator contract (public→private lane)
 - `../../docs/architecture/AGENT_PORTAL_AND_FEDERATION_BRIDGE.md` — architecture spec
+
+---
+
+## 9. Progressive disclosure: `tower_catalog` / `tower_describe` / `tower_invoke`
+
+§8 rejected a **single mega-tool** (`supremeai(operation, …)`) because merging
+schemas collapses per-tool zod validation and blurs the
+tool→provider→action→R-level policy SSoT. That reasoning still holds, and this
+section does not overturn it. It solves the *actual* underlying problem —
+**~178 descriptors in every `tools/list` response** — without merging anything.
+
+### What was added
+
+| Tool | Purpose |
+|---|---|
+| `tower_catalog` | Paginated, RBAC-filtered search over the **entire** registry (including tools hidden from `tools/list`). Returns name, domain, risk, one-line summary. |
+| `tower_describe` | The **authoritative** contract of one tool — parameters, types, required flags, risk, annotations — reflected from the live registration, so it cannot drift from the call path. |
+| `tower_invoke` | Dispatches to the target tool's **own** handler. The target's zod shape is parsed first, then the target's governed wrapper runs (RBAC, per-(identity,tool) rate limit, payload cap, timeout, truncation). |
+
+### Why this satisfies both constraints
+
+1. **No schema merging.** Each tool keeps its own zod schema. `tower_invoke`
+   parses the caller's `arguments` against that exact shape before dispatch, so
+   validation is *not* bypassed — it is applied one layer earlier as well.
+2. **No second metadata source.** The catalog is populated from the same
+   `server.tool` / `server.registerTool` interception point in `src/index.ts`
+   that already installs the governance wrapper. Descriptors and enforcement
+   come from one registration event; there is nothing to drift (#2429).
+3. **No loss of authorization.** `tower_catalog`/`tower_describe` filter through
+   `toolListAccessError` (the same `list ⊆ call` composition the discovery
+   filter uses), and `tower_invoke` re-checks `toolAccessError` plus runs the
+   governed handler — defence in depth, RBAC stays the enforcement layer.
+4. **Anti-hallucination by construction.** The master layer never synthesizes a
+   payload: it returns the target's response verbatim, or `isError` with the
+   target's own error. Invalid arguments produce a field-level error naming the
+   offending path, so a model self-corrects instead of reporting success.
+   Unknown names return the closest real names — never an invented tool.
+5. **Destructive actions stay guarded.** `tower_invoke` refuses a destructive
+   target unless `confirm: true` is passed, *in addition to* whatever guard the
+   target tool already implements.
+
+### Rollout
+
+- `src/policy/tool-visibility.ts`: the three masters are appended to
+  `STANDARD_CURATED_TOOLS`, and a new `catalog` profile exposes masters + eight
+  ambient read tools (11 descriptors instead of ~180) for clients that want the
+  smallest possible surface.
+- `tower_invoke` is listed in `MUTATING_TOOLS`, so the `readonly` profile never
+  gains a write path through the router.
+- Rollback is unchanged: `MCP_DISCOVERY_FILTER=off` restores the unfiltered SDK
+  surface; the masters are additive and can be dropped from the profile lists
+  without touching any concrete tool.
+
+### Evidence
+
+`test_tower_catalog.ts` (wired into `test:unit` and `test:tower-ci`) covers six
+groups: pagination/filtering, schema reflection, validation-first invoke (the
+handler must **not** run on invalid arguments), destructive `confirm` gating,
+meta-tool recursion refusal, and an end-to-end run over the real MCP SDK
+(`InMemoryTransport`) asserting `tools/list` = the three masters and that a
+`tower_invoke` round-trip returns the target's real payload.
