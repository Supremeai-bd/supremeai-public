+++ b/scripts/ci/check_module_budget.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Keep top-level module count NON-INCREASING (sprawl ratchet).
+
+Context: ``core/`` carries 150 top-level modules, eleven of them ``config*``
+(``config``, ``config_cache``, ``config_classification``, ``config_control_plane``,
+``config_fields``, ``config_parsers``, ``config_proxy``, ``config_registry``,
+``config_validation``, ``config_validator``). Each one is individually
+justified — ``config_fields``/``config_validation`` really are the internal
+decomposition of ``Settings`` — but the *aggregate* is the problem: a newcomer
+cannot tell which of the eleven owns a given concern, and every new concern
+historically spawned a twelfth file.
+
+A big-bang merge would break 230+ import sites for cosmetic gain. This guard
+takes the cheap, reversible half: the count may never grow again. New
+responsibility must land in an existing module (or replace one), and every
+deletion lowers the budget below.
+
+Usage:
+    python scripts/ci/check_module_budget.py
+    python scripts/ci/check_module_budget.py --show     # current vs budget
+    python scripts/ci/check_module_budget.py --lower    # print the tightened value
+"""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+
+# (glob, budget, rationale)
+BUDGETS: tuple[tuple[str, int, str], ...] = (
+    ("core/*.py", 150, "top-level core modules (11 config*, 4 health*, 3 intent*)"),
+    ("core/api/routes/*.py", 162, "flat route modules mounted by core/api/routers.py"),
+)
+
+
+def count(pattern: str) -> int:
+    # Only files directly matching the glob — `core/*.py` must not recurse, or
+    # every subpackage module would inflate the figure and the guard would be
+    # meaningless.
+    return len(sorted(ROOT.glob(pattern)))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--show", action="store_true")
+    parser.add_argument("--lower", action="store_true")
+    args = parser.parse_args()
+
+    violations: list[str] = []
+    rows: list[str] = []
+    for pattern, budget, why in BUDGETS:
+        actual = count(pattern)
+        rows.append(f"{pattern:28} {actual:4} / {budget:4}  {'OK' if actual <= budget else 'OVER'}  — {why}")
+        if actual > budget:
+            violations.append(
+                f"{pattern}: {actual} modules > budget {budget}. "
+                "Add the new responsibility to an existing module, or delete an obsolete one and "
+                f"lower the budget in {__file__.replace(str(ROOT) + '/', '')}."
+            )
+
+    if args.lower:
+        for pattern, _budget, _why in BUDGETS:
+            print(f'    ("{pattern}", {count(pattern)}),')
+        return 0
+    if args.show:
+        print("\n".join(rows))
+        return 0
+
+    print("\n".join(rows))
+    for v in violations:
+        print(f"::error::{v}")
+    if violations:
+        return 2
+    print("module budget OK (non-increasing)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/ci/check_mypy_ratchet.py b/scripts/ci/check_mypy_ratchet.py
