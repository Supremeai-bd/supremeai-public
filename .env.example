# ==============================================================================
# SupremeAI Studio — Categorized Environment Template (.env.example)
# Copy to .env for local development or configure in Render / Cloudflare / GitHub
# ==============================================================================

# --- Core Server & Gateway ---
PORT=3000
APP_URL=
SUPREMEAI_BACKEND_URL=
ALLOWED_ORIGINS=
ALLOW_PUBLIC_LIVE_VOICE=
ALLOW_UNSANDBOXED_PROJECT_RUN=
ALLOW_DIRECT_BILLING_TOPUP=

# --- Admin Security & Signing Secrets ---
# বাংলা মন্তব্য: অ্যাডমিন অথ এখন fail-closed — ADMIN_ACCESS_TOKEN / SUPREMEAI_ADMIN_TOKEN /
# ADMIN_PASSWORD এর যেকোনো একটি অন্তত ৩২ অক্ষরের র‍্যান্ডম ভ্যালুতে সেট করতে হবে;
# কোনো ডিফল্ট বা ব্যাকডোর সিক্রেট নেই — না থাকলে সব অ্যাডমিন রুট 503 দেবে।
ADMIN_ACCESS_TOKEN=
SUPREMEAI_ADMIN_TOKEN=
ADMIN_PASSWORD=
ADMIN_USER_IDS=
ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_JWT_SECRET=
ADMIN_KEY=
ADMIN_PASSKEY=
ADMIN_TOTP_SECRET=
AUTH_TOKEN_SECRET=
SESSION_SECRET=
GMAIL_SESSION_SECRET=
STEALTH_WEBHOOK_SECRET=
STEALTH_WEBHOOK_URL=

# --- Persistence (Redis, Supabase, Firebase, Infisical) ---
REDIS_URL=
SUPABASE_URL=
SUPREMEAI_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INFISICAL_PROJECT_ID=
INFISICAL_TOKEN=

# --- AI Providers & Vision Models ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
GEMINI_FALLBACK_VISION_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
CLOUDFLARE_VISION_MODEL=
VERTEX_PROJECT_ID=

# --- MCP Tower, Render & Billing ---
SUPREMEAI_MCP_TOWER_URL=
SUPREMEAI_MCP_HEALTH_URL=
SUPREMEAI_TOWER_TOKEN=
MCP_TOWER_AGENT_KEY=
RENDER_API_KEY=
RENDER_SERVICE_ID_API=
RENDER_SERVICE_ID_BROWSER=
RENDER_SERVICE_ID_MCP=
STRIPE_SECRET_KEY=

# --- Git OAuth & Cloudflare Deployment ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_READONLY_TOKEN=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_HOST=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Tauri Native Desktop & Android Runtime (Optional Overrides) ---
SUPREMEAI_API_URL=
SUPREMEAI_CORE_URL=
SUPREMEAI_SUPABASE_URL=
SUPREMEAI_DESKTOP_NO_PERSIST_SESSION=

# --- Frontend Public Build Variables (VITE_*) ---
VITE_API_BASE_URL=
VITE_GATEWAY_URL=
VITE_WS_BASE_URL=
VITE_MCP_TOWER_URL=
VITE_SUPABASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
