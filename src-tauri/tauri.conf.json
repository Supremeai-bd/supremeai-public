{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupremeAI Desktop",
  "version": "2.5.0",
  "identifier": "com.supremeai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SupremeAI Studio Desktop",
        "width": 1380,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://tauri.localhost http://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost https://tauri.localhost http://tauri.localhost https: wss:; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'nonce-${NONCE}' https://fonts.googleapis.com; script-src 'self' 'nonce-${NONCE}' 'nonce-${NONCE}'; frame-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
