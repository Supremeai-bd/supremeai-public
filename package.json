{
  "name": "@supremeai/desktop",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "SupremeAI Studio Unified Single-Source Monorepo — Web, Desktop & Android via React 19 + Tauri v2",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "lint": "eslint . && npm run lint:structure && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && vite build",
    "build:web": "npm run typecheck && vite build --base=/",
    "build:app": "npm run typecheck && vite build --base=./",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:app && tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "npm run build:app && tauri android build --apk",
    "test:security": "tsx --test src/shared/productionHardening.test.ts",
    "version:sync": "node scripts/sync-versions.mjs",
    "test": "npm run test:security && vitest run",
    "typecheck:edge": "tsc -p tsconfig.edge.json",
    "lint:structure": "node scripts/check-server-budget.mjs",
    "split:deps": "node scripts/server-scope-deps.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.0.0",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/d3": "^7.4.3",
    "@types/express": "4.17.21",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3": "^7.9.2",
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "monaco-editor": "^0.57.0",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
