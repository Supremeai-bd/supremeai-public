+        self.assertEqual(
+            base64.urlsafe_b64decode(opts.json()["user"]["id"] + "==").decode(),
+            "usr-" + supa_uid[:16],
+        )
+
+    def test_devices_cannot_be_read_or_revoked_across_accounts(self):
