diff --git a/.github/workflows/unified-pipeline.yml b/.github/workflows/unified-pipeline.yml
index 0af34cff..ff298e94 100644
--- a/.github/workflows/unified-pipeline.yml
+++ b/.github/workflows/unified-pipeline.yml
@@ -1003,17 +1003,17 @@ jobs:
     # RETIRED Vercel job below did deploy automatically. That inversion is why
     # the proxy kept pointing at the archived Vercel build long after the origin
     # was changed in the repository.
+    # 2026-11-27: every push now enters this job; the "Detect Cloudflare-relevant
+    # changes" step does the real `git diff BEFORE..SHA` path filter and skips
+    # all deploy steps when nothing under studio/ or infrastructure/cloudflare*
+    # changed. The old job-level filter used `join(github.event.commits.*.modified,
+    # ' ')` — a list of LISTS, so join() stringified each inner list as "Array"
+    # and contains() was ALWAYS false: the keep-warm worker and edge proxy never
+    # auto-deployed (every run 2026-11-21..27 shows this job "skipped").
     if: |
       always() && github.ref == 'refs/heads/main' &&
       (
-        (github.event_name == 'push' && (
-          contains(join(github.event.commits.*.modified, ' '), 'infrastructure/cloudflare-studio-proxy/') ||
-          contains(join(github.event.commits.*.added, ' '), 'infrastructure/cloudflare-studio-proxy/') ||
-          contains(join(github.event.commits.*.removed, ' '), 'infrastructure/cloudflare-studio-proxy/') ||
-          contains(join(github.event.commits.*.modified, ' '), 'infrastructure/cloudflare-render-keepwarm/') ||
-          contains(join(github.event.commits.*.added, ' '), 'infrastructure/cloudflare-render-keepwarm/') ||
-          contains(join(github.event.commits.*.modified, ' '), 'wrangler')
-        )) ||
+        github.event_name == 'push' ||
         (github.event_name == 'workflow_dispatch' && inputs.force_deploy == true && (
           contains(inputs.target_service, 'all') ||
           contains(inputs.target_service, 'cloudflare') ||
@@ -1041,9 +1041,13 @@ jobs:
         run: |
           set -euo pipefail
           SHOULD_DEPLOY="false"
+          KEEPWARM="false"
+          PROXY="false"
           # Manual force or explicit cloudflare target always deploys
           if [ "$GITHUB_EVENT_NAME" = "workflow_dispatch" ] && { [ "$FORCE_DEPLOY" = "true" ] || printf '%s\n' "$DEPLOY_TARGETS" | grep -qiE '(^|,)(all|cloudflare|studio)(,|$)'; }; then
             SHOULD_DEPLOY="true"
+            KEEPWARM="true"
+            PROXY="true"
           elif [ "${{ github.event_name }}" = "push" ]; then
             BASE="${{ github.event.before }}"
             HEAD="${{ github.sha }}"
@@ -1056,8 +1060,19 @@ jobs:
             if echo "$CHANGED" | grep -qE '^(studio/|infrastructure/cloudflare)'; then
               SHOULD_DEPLOY="true"
             fi
+            # Per-worker flags: a keep-warm change must not redeploy the edge
+            # proxy (and vice versa) now that every push reaches this job.
+            if echo "$CHANGED" | grep -qE '^infrastructure/cloudflare-render-keepwarm/'; then
+              KEEPWARM="true"
+            fi
+            if echo "$CHANGED" | grep -qE '^infrastructure/cloudflare-studio-proxy/'; then
+              PROXY="true"
+            fi
           fi
           echo "should_deploy=$SHOULD_DEPLOY" >> "$GITHUB_OUTPUT"
+          echo "keepwarm=$KEEPWARM" >> "$GITHUB_OUTPUT"
+          echo "proxy=$PROXY" >> "$GITHUB_OUTPUT"
+          echo "Keep-warm worker deploy: $KEEPWARM · Studio proxy deploy: $PROXY"
           echo "Cloudflare deploy needed: $SHOULD_DEPLOY"
 
       - name: Setup Node.js
@@ -1067,7 +1082,7 @@ jobs:
           node-version: 22
 
       - name: Deploy Keep-Warm Worker
-        if: steps.cf_changes.outputs.should_deploy == 'true'
+        if: steps.cf_changes.outputs.keepwarm == 'true'
         env:
           CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
           CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
@@ -1085,7 +1100,7 @@ jobs:
           fi
 
       - name: Deploy Studio Edge Proxy
-        if: steps.cf_changes.outputs.should_deploy == 'true'
+        if: steps.cf_changes.outputs.proxy == 'true'
         env:
           CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
           CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
