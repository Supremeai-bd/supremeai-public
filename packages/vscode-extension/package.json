{
  "name": "supremeai-vscode",
  "displayName": "SupremeAI Federation IDE Bridge",
  "description": "Developer workflow bridge, AI coding chat, and live federation runway telemetry for SupremeAI autonomous agents",
  "version": "2.5.0",
  "publisher": "supremeai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Supremeai-bd/supremeai-public.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "supremeai",
    "mcp",
    "agents",
    "runway",
    "telemetry"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "supremeai.dispatchTask",
        "title": "Dispatch Task to Federation",
        "category": "SupremeAI"
      },
      {
        "command": "supremeai.viewRunway",
        "title": "View Active PR Runway",
        "category": "SupremeAI"
      },
      {
        "command": "supremeai.emergencyStop",
        "title": "Trigger Emergency Autonomy Kill-Switch",
        "category": "SupremeAI"
      },
      {
        "command": "supremeai.askSelection",
        "title": "Ask SupremeAI about Selection",
        "category": "SupremeAI"
      },
      {
        "command": "supremeai.openChat",
        "title": "Open SupremeAI Chat",
        "category": "SupremeAI"
      },
      {
        "command": "supremeai.checkUpdates",
        "title": "Check for SupremeAI Updates & Platform Installers",
        "category": "SupremeAI"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "supremeai",
          "title": "SupremeAI",
          "icon": "media/chat.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "supremeai.askSelection",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorHasSelection"
      }
    ],
    "views": {
      "supremeai": [
        {
          "id": "supremeai.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SupremeAI Configuration",
      "properties": {
        "supremeai.towerUrl": {
          "type": "string",
          "default": "https://supremeai-mcp-tower-live.onrender.com/mcp",
          "description": "MCP Control Tower URL for task dispatch and telemetry"
        },
        "supremeai.autoRefreshSeconds": {
          "type": "number",
          "default": 30,
          "description": "Telemetry poll cadence in seconds"
        },
        "supremeai.enableNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when an agent completes a task, CI gate fails, or an update is available"
        },
        "supremeai.gatewayUrl": {
          "type": "string",
          "default": "https://supremeai-api-ulw0.onrender.com",
          "description": "SupremeAI Gateway base URL for chat completions"
        },
        "supremeai.apiKey": {
          "type": "string",
          "default": "",
          "description": "X-SupremeAI-Key for gateway authentication (or SUPREMEAI_API_KEY environment variable)"
        },
        "supremeai.model": {
          "type": "string",
          "default": "auto",
          "description": "Default model tier (auto, fast, balanced, pro)"
        },
        "supremeai.autoCheckUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Silently check latest-release.json on startup for VSIX/Desktop/Android updates"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsx src/test/extension.test.ts",
    "package": "vsce package --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.80.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
