# Cloudflare Pages response headers for the static app shell.
#
# Script/style sources are allowlisted to the exact CDNs the workspace preview
# runtime uses (cdn.tailwindcss.com, unpkg.com, cdn.jsdelivr.net, esm.sh).
# 'unsafe-eval' is required by Babel Standalone inside the sandboxed preview
# iframe, and 'unsafe-inline' by the generated artifact documents; both are
# scoped to that iframe by the `sandbox` attribute, not by CSP. Removing them
# requires bundling the preview runtime locally (tracked in the audit doc).

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://esm.sh https://challenges.cloudflare.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' blob: data: https://*.firebaseapp.com https://challenges.cloudflare.com https://accounts.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'self' vscode-webview:; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(self), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Generated preview artifacts render in a sandboxed (opaque-origin) iframe, so
# static assets must stay readable from it.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
